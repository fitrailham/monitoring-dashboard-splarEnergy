# Target proxy Vite untuk request /api saat development dan preview.
API_PROXY_TARGET=http://127.0.0.1:8000
# Opsional untuk backend lama yang belum menyediakan endpoint dashboard /api/v1.
API_PROXY_LEGACY_DASHBOARD=false

# Kosong untuk deployment yang meneruskan /api melalui origin frontend.
# Isi hanya jika build produksi perlu memanggil API dari origin tersendiri.
# Konfigurasi VITE_* tersedia untuk browser. Jangan isi dengan kredensial.
VITE_API_URL=

# License key AG Grid Enterprise; kosong/tidak valid memakai menu custom Community.
VITE_AG_GRID_LICENSE_KEY=

# Opsional: path backend analisis CV yang mengikuti docs/cv-analysis-api.md.
# Kosong berarti analisis belum terhubung; tidak ada data CV simulasi.
VITE_CV_ANALYSIS_PATH=
