  "components": {
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "icongreen_session",
        "description": "Cookie sesi HttpOnly dari login backend yang sudah ada."
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "description": "Nomor halaman berbasis 1.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "PageSize": {
        "name": "page_size",
        "in": "query",
        "description": "Jumlah baris per halaman. FE mengirim 100.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 100
        }
      },
      "SnapshotId": {
        "name": "snapshot_id",
        "in": "query",
        "description": "Kirim meta.snapshot_id dari halaman pertama pada setiap halaman berikutnya.",
        "schema": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Sesi tidak tersedia atau telah berakhir.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "success": false,
              "data": null,
              "message": "Sesi tidak valid atau sudah berakhir.",
              "error": {
                "code": "UNAUTHORIZED",
                "retryable": false
              },
              "request_id": "req-contoh-unauthorized"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Akses ke sumber daya ditolak.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "success": false,
              "data": null,
              "message": "Anda tidak memiliki akses ke data ini.",
              "error": {
                "code": "PLANT_ACCESS_DENIED",
                "retryable": false
              },
              "request_id": "req-contoh-plant-access-denied"
            }
          }
        }
      },
      "InvalidQuery": {
        "description": "Parameter query tidak valid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "success": false,
              "data": null,
              "message": "Periksa parameter atau data yang dikirim.",
              "error": {
                "code": "VALIDATION_ERROR",
                "retryable": false
              },
              "request_id": "req-contoh-validation-error"
            }
          }
        }
      },
      "SnapshotChanged": {
        "description": "Snapshot daftar berubah saat pagination.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "success": false,
              "data": null,
              "message": "Data berubah. Muat ulang dari halaman pertama.",
              "error": {
                "code": "SNAPSHOT_CHANGED",
                "retryable": true
              },
              "request_id": "req-contoh-snapshot-changed"
            }
          }
        }
      },
      "Unavailable": {
        "description": "Sumber sementara tidak dapat memberikan snapshot.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "success": false,
              "data": null,
              "message": "Sumber data belum dapat diakses. Coba kembali.",
              "error": {
                "code": "SOURCE_UNAVAILABLE",
                "retryable": true
              },
              "request_id": "req-contoh-source-unavailable"
            }
          }
        }
      }
    },
    "schemas": {
      "Meta": {
        "type": "object",
        "required": [
          "generated_at"
        ],
        "properties": {
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "snapshot_id": {
            "type": "string",
            "minLength": 1
          },
          "is_partial": {
            "type": "boolean"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "time_zone": {
            "type": "string"
          },
          "returned": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "PageMeta": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Meta"
          },
          {
            "type": "object",
            "required": [
              "snapshot_id",
              "page",
              "page_size",
              "total_pages"
            ],
            "properties": {
              "snapshot_id": {
                "type": "string",
                "minLength": 1,
                "description": "ID snapshot yang sama untuk setiap halaman dari kumpulan hasil yang sama."
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "page_size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "total_pages": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        ]
      },
      "MetricCoverage": {
        "type": "object",
        "required": [
          "expected",
          "valid",
          "missing",
          "stale",
          "unverified",
          "not_applicable",
          "partial"
        ],
        "properties": {
          "expected": {
            "type": "integer",
            "minimum": 0
          },
          "valid": {
            "type": "integer",
            "minimum": 0
          },
          "missing": {
            "type": "integer",
            "minimum": 0
          },
          "stale": {
            "type": "integer",
            "minimum": 0
          },
          "unverified": {
            "type": "integer",
            "minimum": 0
          },
          "not_applicable": {
            "type": "integer",
            "minimum": 0
          },
          "partial": {
            "type": "boolean"
          }
        }
      },
      "OverviewResponse": {
        "type": "object",
        "required": [
          "success",
          "data",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "object",
            "required": [
              "kpis"
            ],
            "properties": {
              "total_plants": {
                "type": "integer",
                "minimum": 0
              },
              "updated_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "quality": {
                "type": "string",
                "enum": [
                  "fresh",
                  "partial",
                  "stale",
                  "missing",
                  "unverified"
                ]
              },
              "kpis": {
                "type": "object",
                "required": [
                  "current_power_kw",
                  "revenue_today_idr",
                  "ess_rated_capacity_kwh",
                  "yield_today_kwh",
                  "inverter_rated_power_kw",
                  "total_yield_kwh"
                ],
                "properties": {
                  "current_power_kw": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Daya aktif pembangkitan dari pengukuran valid, dalam kW."
                  },
                  "revenue_today_idr": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Pendapatan atau manfaat ekonomi pada tanggal bisnis yang diminta, dalam IDR."
                  },
                  "ess_rated_capacity_kwh": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Kapasitas energi nominal ESS, dalam kWh."
                  },
                  "yield_today_kwh": {
                    "type": [
                      "number",
                      "null"
