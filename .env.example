# Base URL backend monitoring yang menyediakan /api/database/overview.
# Konfigurasi VITE_* tersedia untuk browser; jangan isi dengan kredensial.
VITE_API_URL=http://127.0.0.1:8000

# License key AG Grid Enterprise; kosong/tidak valid memakai menu custom Community.
VITE_AG_GRID_LICENSE_KEY=

# Opsional: path backend analisis CV yang mengikuti docs/cv-analysis-api.md.
# Kosong berarti analisis belum terhubung; tidak ada data CV simulasi.
VITE_CV_ANALYSIS_PATH=
