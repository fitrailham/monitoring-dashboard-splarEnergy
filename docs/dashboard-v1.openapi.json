{
  "openapi": "3.1.0",
  "info": {
    "title": "IconGreen Solar Monitoring — Dashboard Home v1",
    "version": "1.0.0",
    "description": "Usulan kontrak untuk tiga endpoint baca Dashboard Home. Semua angka dan identitas di contoh respons bersifat ilustratif."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000",
      "description": "Server pengembangan setelah rute v1 tersedia."
    }
  ],
  "security": [
    {
      "SessionCookie": []
    }
  ],
  "tags": [
    {
      "name": "Dashboard Home",
      "description": "KPI, daftar dan status PLTS, serta alarm aktif."
    }
  ],
  "paths": {
    "/api/v1/dashboard/overview": {
      "get": {
        "operationId": "getDashboardOverview",
        "tags": [
          "Dashboard Home"
        ],
        "summary": "Ambil enam KPI portofolio.",
        "description": "Agregasi hanya mencakup PLTS yang boleh diakses akun. Kirim angka dalam satuan dasar.",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "description": "Tanggal bisnis YYYY-MM-DD.",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-11-19"
          },
          {
            "name": "time_zone",
            "in": "query",
            "required": true,
            "description": "Zona waktu IANA untuk tanggal bisnis.",
            "schema": {
              "type": "string"
            },
            "example": "Asia/Jakarta"
          }
        ],
        "responses": {
          "200": {
            "description": "Ringkasan KPI untuk tanggal dan cakupan yang diminta.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OverviewResponse"
                },
                "examples": {
                  "partialKpis": {
